{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "toggles",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ORIGIN": "https://toggles.tinytown.studio",
    "BETTER_AUTH_URL": "https://toggles.tinytown.studio",
    "LOCAL": "false",
    "PRODUCT_BETA": "true",
    // Per-workspace invite rate limit (default 20/hour when omitted). Set "0" to disable.
    // "TOGGLES_ORG_INVITES_PER_HOUR": "20",
    // Optional sender for Cloudflare Email (workspace invites). Use a verified Email Service address.
    // "TOGGLES_EMAIL_FROM": "noreply@your-verified-domain.example",
    // "TOGGLES_EMAIL_FROM_NAME": "Toggles",
    // Force email off on hosted Workers (invites still return inviteUrl): "TOGGLES_EMAIL_PROVIDER": "none",
  },
  // Cloudflare Email binding for hosted outbound mail. Requires Email Service on your zone.
  // See packages/app/README.md and https://developers.cloudflare.com/email-service/
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "database_id": "fb628396-e48b-42ff-b41c-68d8b9e90185",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "main": "./api/index.ts",
}
