# Browser / Vite dev: origin where the SPA and API are served (same host in dev).
VITE_API_BASE_URL=http://localhost:5173

# Optional: public site origin for prerendered meta tags and static docs examples at build time.
# Hosted Cloudflare deploy sets this via the `deploy` script; self-hosters set their own origin or omit (defaults to localhost).
# VITE_PUBLIC_APP_ORIGIN=https://toggles.tinytown.studio

# Optional: default sender when outbound email is added (hosted default in wrangler.jsonc: noreply@tinytown.studio).
# TOGGLES_MAIL_FROM=noreply@your-domain.example
