{
  "name": "toggles",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy --minify",
    "preview": "vite preview",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply app-db --remote",
    "db:migrate:node": "drizzle-kit migrate --config ./drizzle.config.node.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint --fix",
    "format:atomic": "oxfmt --write",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@polar-sh/better-auth": "^1.6.4",
    "@polar-sh/sdk": "^0.42.5",
    "@preachjs/toast": "^0.0.6",
    "@preact/signals": "^2.11.4",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "basecoat-css": "^1.1.0",
    "better-auth": "1.4.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "preact": "^10.28.3",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20260207.0",
    "@eslint/js": "^9.39.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "^4.1.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.1.4",
    "wrangler": "^4.156.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.1",
    "nodemailer": "^7.0.6"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
